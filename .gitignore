```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
wheels/

# =========================
# Virtual Environments
# =========================
venv/
.venv/
env/
ENV/

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# FastAPI / Uvicorn Logs
# =========================
*.log
logs/

# =========================
# Testing & Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
test-results/

# =========================
# Type Checking & Linting
# =========================
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.pytype/

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

# =========================
# IDEs & Editors
# =========================
.vscode/
.idea/
*.swp
*.swo
*~

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Database Files
# =========================
*.sqlite
*.sqlite3
*.db

# =========================
# Temporary Files
# =========================
tmp/
temp/
*.tmp
*.bak

# =========================
# Build / Package Managers
# =========================
pip-wheel-metadata/
poetry.toml

# =========================
# Docker Overrides
# =========================
docker-compose.override.yml
```
